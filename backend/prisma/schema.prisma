// نظام طلبات وتواصل العمال — PostgreSQL schema
// All timestamps are server-generated `timestamptz(3)` (UTC, millisecond precision).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles are a closed set enforced by guards (RBAC), not editable data.
enum Role {
  SYSTEM_ADMIN
  MANAGER
  WORKER
}

enum RequestStatus {
  ACTIVE
  CANCELLED
}

enum TargetType {
  SINGLE
  MULTIPLE
  ALL
}

enum RecipientStatus {
  NEW
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  NEW_REQUEST
  REMINDER
  REQUEST_UPDATED
  REQUEST_CANCELLED
  REQUEST_REOPENED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  role        Role
  name        String    @db.VarChar(120)
  /// HMAC-SHA256(AUTH_SECRET, pin). Globally unique (one login screen for all roles). Null after soft delete.
  pinHash     String?   @unique @map("pin_hash") @db.VarChar(64)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  worker           WorkerProfile?
  devices          Device[]
  sessions         Session[]
  createdRequests  Request[]           @relation("RequestCreator")
  recipientEntries RequestRecipient[]
  uploads          RequestAttachment[]
  auditLogs        AuditLog[]
  loginLogs        LoginLog[]
  presence         Presence?

  @@index([role, isActive])
  @@map("users")
}

/// Worker-only attributes (1:1 with users where role = WORKER).
model WorkerProfile {
  userId    String   @id @map("user_id") @db.Uuid
  phone     String   @db.VarChar(32)
  photo     Bytes?
  photoMime String?  @map("photo_mime") @db.VarChar(32)
  photoEtag String?  @map("photo_etag") @db.VarChar(64)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("worker_profiles")
}

/// A registered browser/PWA installation. Workers: max one active device (partial unique index in migration).
model Device {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Random id generated by the browser and kept in its storage.
  deviceKey     String    @map("device_key") @db.VarChar(64)
  label         String?   @db.VarChar(160)
  isActive      Boolean   @default(true) @map("is_active")
  boundAt       DateTime  @default(now()) @map("bound_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(40)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@index([userId, isActive])
  @@index([deviceKey])
  @@map("devices")
}

/// Web Push (VAPID) subscription of a device's service worker.
model PushSubscription {
  id          String    @id @default(uuid()) @db.Uuid
  deviceRowId String    @map("device_row_id") @db.Uuid
  endpoint    String    @unique @db.VarChar(1024)
  p256dh      String    @db.VarChar(256)
  auth        String    @db.VarChar(128)
  isActive    Boolean   @default(true) @map("is_active")
  failCount   Int       @default(0) @map("fail_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(3)
  disabledReason String? @map("disabled_reason") @db.VarChar(60)

  device Device @relation(fields: [deviceRowId], references: [id], onDelete: Restrict)

  @@index([deviceRowId, isActive])
  @@map("push_subscriptions")
}

/// Server-side session; the browser only holds an opaque random token in an httpOnly cookie.
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceRowId String    @map("device_row_id") @db.Uuid
  /// HMAC-SHA256 of the cookie token.
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(300)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  device    Device     @relation(fields: [deviceRowId], references: [id], onDelete: Restrict)
  loginLogs LoginLog[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model Request {
  id             String        @id @default(uuid()) @db.Uuid
  /// Human-friendly sequential number (#1024).
  number         Int           @unique @default(autoincrement())
  title          String        @db.VarChar(200)
  createdById    String        @map("created_by_id") @db.Uuid
  targetType     TargetType    @map("target_type")
  status         RequestStatus @default(ACTIVE)
  version        Int           @default(1)
  /// Client-generated key; makes POST /requests safe against double-clicks and retries.
  idempotencyKey String        @map("idempotency_key") @db.VarChar(64)
  resentFromId   String?       @map("resent_from_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  editedAt       DateTime?     @map("edited_at") @db.Timestamptz(3)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)

  createdBy   User                @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resentFrom  Request?            @relation("Resend", fields: [resentFromId], references: [id], onDelete: Restrict)
  resends     Request[]           @relation("Resend")
  recipients  RequestRecipient[]
  attachments RequestAttachment[]

  @@unique([createdById, idempotencyKey])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("requests")
}

/// Per-worker state of a request — each recipient has an independent lifecycle.
model RequestRecipient {
  id             String          @id @default(uuid()) @db.Uuid
  requestId      String          @map("request_id") @db.Uuid
  workerId       String          @map("worker_id") @db.Uuid
  status         RecipientStatus @default(NEW)
  /// Incremented on every status change; offline actions must reference it (conflict detection).
  stateVersion   Int             @default(1) @map("state_version")
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz(3)
  openedAt       DateTime?       @map("opened_at") @db.Timestamptz(3)
  acknowledgedAt DateTime?       @map("acknowledged_at") @db.Timestamptz(3)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  reopenedAt     DateTime?       @map("reopened_at") @db.Timestamptz(3)
  lastNotifiedAt DateTime?       @map("last_notified_at") @db.Timestamptz(3)
  reminderCount  Int             @default(0) @map("reminder_count")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  request       Request        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  worker        User           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([requestId, workerId])
  @@index([workerId, updatedAt])
  @@index([status, openedAt, lastNotifiedAt])
  @@map("request_recipients")
}

/// Compressed images stored inside PostgreSQL (BYTEA). Max 3 per request.
model RequestAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  /// Null while uploaded but not yet attached (two-phase upload, enables retry after network loss).
  requestId      String?  @map("request_id") @db.Uuid
  uploadedById   String   @map("uploaded_by_id") @db.Uuid
  /// Client-generated id → retrying the same upload never creates a duplicate.
  clientUploadId String   @map("client_upload_id") @db.VarChar(64)
  position       Int      @default(0)
  mimeType       String   @map("mime_type") @db.VarChar(32)
  width          Int
  height         Int
  sizeBytes      Int      @map("size_bytes")
  sha256         String   @db.VarChar(64)
  data           Bytes
  thumbnail      Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request    Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([uploadedById, clientUploadId])
  @@index([requestId, position])
  @@map("request_attachments")
}

/// One row per push attempt to a device (tracking: sent → delivered; opened is on the recipient).
model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  recipientId   String             @map("recipient_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  deviceRowId   String?            @map("device_row_id") @db.Uuid
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  error         String?            @db.VarChar(300)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  deliveredAt   DateTime?          @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient RequestRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  device    Device?          @relation(fields: [deviceRowId], references: [id], onDelete: Restrict)

  @@index([recipientId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

/// Latest presence snapshot only — no history is kept.
model Presence {
  userId     String    @id @map("user_id") @db.Uuid
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(3)
  visible    Boolean   @default(true)
  /// Reserved for a possible future location feature (not collected in this version).
  latitude   Float?
  longitude  Float?
  locationAt DateTime? @map("location_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("presence")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  Role?    @map("actor_role")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model LoginLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  sessionId String?  @map("session_id") @db.Uuid
  deviceKey String?  @map("device_key") @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt])
  @@map("login_logs")
}

model Setting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
