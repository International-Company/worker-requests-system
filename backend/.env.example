# ─────────────────────────────────────────────────────────────────────────────
# نظام طلبات وتواصل العمال — backend environment
# Copy to backend/.env for local development. NEVER commit real values.
# On Railway, set these in the service "Variables" tab.
# ─────────────────────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=3000

# Public HTTPS URL of the app (required https:// in production — PWA, service worker and push need it).
# Railway: https://<your-service>.up.railway.app  (or your custom domain)
APP_URL=http://localhost:3000

# PostgreSQL. On Railway use the reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Secret used to HMAC the PINs and session tokens. ≥ 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠ Changing it invalidates every PIN and session (all PINs must be reset).
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Session lifetime (sliding — renewed on use)
SESSION_TTL_DAYS_STAFF=7
SESSION_TTL_DAYS_WORKER=60

# Web Push (VAPID). Generate once:  cd backend && npm run vapid:generate
# Keep the same keys forever (changing them invalidates every browser subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:admin@example.com

# Extra allowed browser origins (comma separated). Leave EMPTY in production
# (the API serves the PWA on the same origin). Local dev with Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Behind Railway's proxy these default to true in production.
# TRUST_PROXY=true
# COOKIE_SECURE=true

# Max upload size per image (MB) before compression
MAX_UPLOAD_MB=10

# Server time zone — used for "today" counters on the dashboard. Timestamps are stored in UTC.
TZ=Asia/Riyadh

# Where the built web app is (the Dockerfile sets this). Default: ../web/dist
# WEB_DIST_PATH=

# Expose Swagger UI (/api/docs) in production too (always on in development)
# ENABLE_SWAGGER=false

# One-time creation of the first system admin on a fresh database (npm run bootstrap:admin)
# BOOTSTRAP_ADMIN_NAME=مدير النظام
# BOOTSTRAP_ADMIN_PIN=
